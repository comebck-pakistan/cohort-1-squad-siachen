# Recepta Bridge — runs the WhatsApp QR-pair transport (Chromium lifecycle).
# Separate process from the main core API. Main API talks to this service over
# HTTP. See backend/.env.example for BRIDGE_URL — these must match.

# Port this bridge listens on. Default 3100 (3000 is the main core API).
BRIDGE_PORT=3100

# Main core API URL. Bridge POSTs inbound messages to /api/bridge/inbound and
# fetches active businesses from /api/bridge/active-businesses on boot.
BACKEND_URL=http://localhost:3000

# Shared secret between Core API and Bridge. Must match BRIDGE_INTERNAL_TOKEN
# in backend/.env. Generate with: openssl rand -hex 32
BRIDGE_INTERNAL_TOKEN=

# Directory for chromium user-data dirs (one LocalAuth session per salon).
# Bind-mount this in production so sessions survive bridge restarts.
WHATSAPP_SESSIONS_ROOT=./sessions

NODE_ENV=development

# ---------------------------------------------------------------------------
# Voice note handling (optional, off by default)
# ---------------------------------------------------------------------------
# When ENABLE_VOICE_NOTES=true, voice notes (msg.type === 'ptt' | 'audio') are
# downloaded from WhatsApp, transcribed via Groq Whisper, and the transcript
# is fed into the same /api/bridge/inbound pipeline as typed text messages.
# Requires GROQ_API_KEY. Stop after local-dev verification before flipping
# this on in production.
#
# Groq accepts raw .ogg/.opus directly from WhatsApp — no ffmpeg needed.
#   docs: https://console.groq.com/docs/speech-text
#
ENABLE_VOICE_NOTES=false
GROQ_API_KEY=

# Per-phone rate limit to protect the Groq bill. Window is 1h.
MAX_VOICE_PER_HOUR=5

# Hard cap on voice note duration (seconds). Rejected pre-Groq if exceeded.
MAX_VOICE_DURATION_SEC=120

# ---------------------------------------------------------------------------
# Image handling (Wave 18, optional, OFF by default)
# ---------------------------------------------------------------------------
# When ENABLE_IMAGES=true, customer image messages (msg.type === 'image')
# are downloaded via msg.downloadMedia() and forwarded to the backend's
# image-analysis pipeline (MiniMax M3 primary → Gemini 2.5 Flash-Lite
# fallback). The bot replies based on the classification — reference
# photo, concern/complaint, or unrelated.
#
# IMPORTANT — ship with this OFF. Before flipping to true in production:
#   1. Verify the providers' data-retention / privacy terms (MiniMax + Google).
#   2. Confirm /privacy and /terms disclose that customer images may be
#      processed by these third-party AI providers.
#   3. Confirm the image_analysis_logs table is in place — it's the
#      audit trail.
#
ENABLE_IMAGES=false

# Hard cap on image size (bytes). Customer photos larger than this are
# rejected pre-download to keep the bridge's 90s per-attempt backend
# timeout in budget. 5MB is a reasonable default; anything over ~3MB
# will inflate beyond 4MB of base64 JSON.
MAX_IMAGE_BYTES=5242880

# Wave 18 — image-download pipeline gate. When false (default), image
# messages are answered with a short clarification text without
# attempting msg.downloadMedia(). This works around the upstream
# whatsapp-web.js r:r regression (issue #201828, PR #201840). Flip to
# true once a patched whatsapp-web.js is installed.
IMAGES_PIPELINE_DOWNLOAD=false

# Wave 18 — image-download diagnostic dump. When true (default false),
# every incoming image triggers a structured pino log line per probe:
#   diag_test1_2_msg_id    -> client.getWWebVersion() + msg.id shape
#   diag_tests_3_4_inpage  -> WAWebCollections.Msg.get(candidate)
#                          + WAWebDownloadManager.downloadAndMaybeDecrypt
#                            called directly (real exception, not r:r).
# Useful for distinguishing the upstream $1 regression from a deeper
# DownloadManager failure. Remove once an actual fix lands.
DIAGNOSE_IMAGE_DOWNLOAD=false
