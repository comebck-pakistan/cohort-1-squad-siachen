# Recepta Bridge — runs the WhatsApp QR-pair transport (Chromium lifecycle).
# Separate process from the main core API. Main API talks to this service over
# HTTP. See backend/.env.example for BRIDGE_URL — these must match.

# Port this bridge listens on. Default 3100 (3000 is the main core API).
BRIDGE_PORT=3100

# Main core API URL. Bridge POSTs inbound messages to /api/bridge/inbound and
# fetches active businesses from /api/bridge/active-businesses on boot.
BACKEND_URL=http://localhost:3000

# Shared secret between Core API and Bridge. Must match BRIDGE_INTERNAL_TOKEN
# in backend/.env. Generate with: openssl rand -hex 32
BRIDGE_INTERNAL_TOKEN=

# Directory for chromium user-data dirs (one LocalAuth session per salon).
# Bind-mount this in production so sessions survive bridge restarts.
WHATSAPP_SESSIONS_ROOT=./sessions

NODE_ENV=development

# ---------------------------------------------------------------------------
# Voice note handling (optional, off by default)
# ---------------------------------------------------------------------------
# When ENABLE_VOICE_NOTES=true, voice notes (msg.type === 'ptt' | 'audio') are
# downloaded from WhatsApp, transcribed via Groq Whisper, and the transcript
# is fed into the same /api/bridge/inbound pipeline as typed text messages.
# Requires GROQ_API_KEY. Stop after local-dev verification before flipping
# this on in production.
#
# Groq accepts raw .ogg/.opus directly from WhatsApp — no ffmpeg needed.
#   docs: https://console.groq.com/docs/speech-text
#
ENABLE_VOICE_NOTES=false
GROQ_API_KEY=

# Per-phone rate limit to protect the Groq bill. Window is 1h.
MAX_VOICE_PER_HOUR=5

# Hard cap on voice note duration (seconds). Rejected pre-Groq if exceeded.
MAX_VOICE_DURATION_SEC=120
