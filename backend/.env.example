# Server
PORT=3000

# WhatsApp Cloud API (from Meta Developer Dashboard)
WHATSAPP_PHONE_NUMBER_ID=your_15_digit_phone_number_id
WHATSAPP_WABA_ID=your_waba_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose

# Supabase (from Supabase project settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LLM (add later when LLM is decided)
# ANTHROPIC_API_KEY=sk-ant-...

# Wave 18 — image analysis fallback provider. Optional. Leave blank to
# skip the Gemini fallback (the bot will still try MiniMax M3 first,
# and fall back to a generic "got your photo" message if that fails).
# See backend/src/lib/image-analysis.ts for provider details.
# GEMINI_API_KEY=...

# Wave 13 — payment subscriptions (manual approval flow).
# These are shown on the /payment page so customers know where to send money.
# Replace with real numbers + bank details before going live.
JAZZCASH_MERCHANT_NUMBER=0300XXXXXXX
EASYPAISA_MERCHANT_NUMBER=0300XXXXXXX
BANK_ACCOUNT_TITLE=Vara Ali
BANK_ACCOUNT_NUMBER=0000000000000
BANK_IBAN=PK00XXXX0000000000000000
BANK_NAME=Bank Alfalah

# Wave 13 — SafePay (Phase 2, optional). Leave blank for MVP.
# SAFEPAY_PUBLIC_KEY=
# SAFEPAY_SECRET_KEY=
# SAFEPAY_WEBHOOK_SECRET=
# SAFEPAY_ENVIRONMENT=sandbox

